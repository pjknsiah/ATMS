# ── Detection ─────────────────────────────────────────────────────────
MODEL_WEIGHTS=data/weights/yolo11n.pt
CONFIDENCE_THRESHOLD=0.45
VEHICLE_CLASSES=car,motorcycle,bus,truck

# ── Pipeline ──────────────────────────────────────────────────────────
LANE_COUNT=4
VIDEO_DIR=data/samples
WINDOW_SECONDS=5
EVERY_N_FRAMES=5       # sample 1 in every N video frames per window (higher = faster, less precise)
COLLECT_TIMEOUT=60     # seconds to wait for all lanes to report before deciding (increase on slow CPUs)

# ── Signal controller ─────────────────────────────────────────────────
DEADLOCK_THRESHOLD=2

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
